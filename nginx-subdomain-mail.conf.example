# Nginx Reverse Proxy for ClearMail Subdomain
# e.g., mail.mainserver.in pointing to ClearMail Docker container on Port 7510
#
# Save this file to: /etc/nginx/sites-available/clearmail
# Symlink to:        /etc/nginx/sites-enabled/clearmail
# Run:               sudo certbot --nginx -d mail.mainserver.in

server {
    listen 80;
    server_name mail.mainserver.in;

    # Forward all traffic to ClearMail Docker container on port 7510
    location / {
        proxy_pass http://127.0.0.1:7510;
        proxy_http_version 1.1;

        # WebSocket support for instant real-time push (<100ms sync)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Max attachment size (50MB)
        client_max_body_size 50M;
    }
}

